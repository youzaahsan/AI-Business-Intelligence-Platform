# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Application Environment
APP_ENV=development
DEBUG=false
PORT=3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_bi
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=super-secure-jwt-key-replace-with-64-char-random-string-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=86400
REFRESH_TOKEN_EXPIRES_IN=604800

# Multi-Agent LLM Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=text-embedding-004

# Vector Database (ChromaDB / Qdrant)
VECTOR_DB_PROVIDER=chromadb
VECTOR_DB_URL=http://localhost:8000
VECTOR_DB_COLLECTION=nexus_bi_knowledge

# External Research APIs
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=

# File Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads
STORAGE_BUCKET=nexus-bi-uploads

# CORS & Networking
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
